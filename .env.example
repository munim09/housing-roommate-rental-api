SSL_PASSWORD=

SSL_STORE_ID=
SSL_STORE_PASSWD=

FRONT_END_URL="http://localhost:5000"


GOOGLE_CLIENT_ID=


REDIS_USER=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=

SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=


CLOUDINARY_CLOUD_NAME=
